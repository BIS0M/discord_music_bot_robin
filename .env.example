# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.

# Discord 개발자 포털 > Bot > Reset Token 으로 받은 토큰
DISCORD_TOKEN=

# 봇을 쓸 서버 ID (쉼표로 구분). 넣으면 슬래시 명령어가 바로 뜸
GUILD_IDS=

# (선택) 유튜브 쿠키 파일 경로 - 서버에서 차단될 때 사용
# YT_COOKIES=cookies.txt

# (선택) ffmpeg 경로 - PATH에 없을 때만
# FFMPEG_PATH=ffmpeg

# (선택) 전송 음질 kbps. 기본 128, GCP 등 트래픽 아끼려면 64
# BITRATE=64

# (선택) 봇 기본 볼륨 0~100 (기본 50)
# DEFAULT_VOLUME=50
